<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="clock"><xs:restriction base="xs:string"><xs:pattern value="([01][0-9]|2[0-3]):[0-5][0-9]"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="dayName">
    <xs:restriction base="xs:string">
      <xs:enumeration value="пн"/><xs:enumeration value="вт"/><xs:enumeration value="ср"/>
      <xs:enumeration value="чт"/><xs:enumeration value="пт"/><xs:enumeration value="сб"/><xs:enumeration value="вс"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="schedule">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="lesson" maxOccurs="unbounded" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="id" type="xs:ID" use="required"/>
            <xs:attribute name="topic" type="xs:string" use="required"/>
            <xs:attribute name="chef" type="xs:string" use="required"/>
            <xs:attribute name="day" type="dayName" use="required"/>
            <xs:attribute name="day_index" use="required">
              <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:minInclusive value="1"/><xs:maxInclusive value="7"/></xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="date" type="xs:date" use="required"/>
            <xs:attribute name="time" type="clock" use="required"/>
            <xs:attribute name="duration" type="xs:positiveInteger" use="required"/>
            <xs:attribute name="seats" type="xs:positiveInteger" use="required"/>
            <xs:attribute name="price" type="xs:nonNegativeInteger" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="week" type="xs:positiveInteger" use="required"/>
      <xs:attribute name="updated" type="xs:date" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>